# Required: your TeamDynamix organization or Web API URL.
# Standard organization root (the server appends /TDWebApi/api):
TEAMDYNAMIX_BASE_URL=https://yourorg.teamdynamix.com
# Sandbox/custom Web API root (the server appends /api):
# TEAMDYNAMIX_BASE_URL=https://yourorg.teamdynamix.com/SBTDWebApi
# A complete API root is also accepted:
# TEAMDYNAMIX_BASE_URL=https://yourorg.teamdynamix.com/TDWebApi/api

# --- Authentication: choose ONE of the following methods ---

# Option A: standard user or service-account username/password login.
# Actions will appear in TeamDynamix as performed by this user.
# TEAMDYNAMIX_USERNAME=
# TEAMDYNAMIX_PASSWORD=

# Option B: admin service account login (key-based).
# Find BEID and WebServicesKey on TDAdmin's organization detail page.
# Requires the "Add BE Administrators" permission to set up, and the
# admin service account must be Active.
TEAMDYNAMIX_BEID=
TEAMDYNAMIX_WS_KEY=

# Option C: sign in as yourself through SSO (one user per local or Hermes deployment).
# Every call runs with YOUR TeamDynamix roles and shows YOU in audit trails.
# Run `npm run login` once to establish the local browser profile; the server renews
# the 24-hour token silently while that SSO session remains valid.
# TEAMDYNAMIX_AUTH_METHOD=sso
# Refuse to save a token for anyone else (email or username):
# TEAMDYNAMIX_SSO_EXPECTED_USER=you@yourorg.edu
# Browser used by `npm run login`: msedge (default), chrome, or chromium.
# TEAMDYNAMIX_SSO_BROWSER=msedge
# Select local (default) or external (one Hermes workspace, loopback HTTP only).
# TEAMDYNAMIX_MCP_DEPLOYMENT=local
# External Hermes: required expected user, independent MCP secret, and loopback CDP.
# TEAMDYNAMIX_MCP_DEPLOYMENT=external
# TEAMDYNAMIX_SSO_CDP_ENDPOINT=http://127.0.0.1:9222
# Renew one hour before expiry with up to three transient retries.
# TEAMDYNAMIX_SSO_RENEW_LEAD_MS=3600000
# TEAMDYNAMIX_SSO_RENEW_RETRIES=3
# Where tokens and the login browser profile are kept (default: %LOCALAPPDATA%\tdx-mcp).
# TDX_HOME=

# Optional: force which auth method to use if both are set ("user", "admin" or "sso").
# TEAMDYNAMIX_AUTH_METHOD=user

# Optional: omit every tool that changes TeamDynamix. The exact value "true"
# is required; leave unset for the normal read/write tool set.
# TEAMDYNAMIX_READ_ONLY=true

# --- Tool policy ---
# config/tool-policy.json decides which tools are registered. By default the
# "edit" and "destroy" tiers are denied, so records can be created and commented
# on but not rewritten or deleted. These variables override the file.

# Optional: use a policy file somewhere else (handy for mounted container config).
# TDX_TOOL_POLICY_FILE=/etc/tdx-mcp/tool-policy.json

# Optional: replace the file's capability defaults. Any tier left out is denied.
# TDX_ALLOW_CAPABILITIES=read,create

# Optional: register only these tools, ignoring every other rule.
# TDX_ALLOW_TOOLS=teamdynamix_search_tickets,teamdynamix_get_ticket

# Optional: deny these tools, overriding every other rule.
# TDX_DENY_TOOLS=teamdynamix_remove_group_members

# Optional: default application for app-scoped tools, so agents can omit app_id.
# Strongly recommended when the organization has many ticketing applications.
# Discover IDs with `npm run list-apps`.
# TEAMDYNAMIX_DEFAULT_APP_ID=

# --- HTTP client tuning (defaults shown) ---

# Persist the JWT across short-lived processes: "memory" (default) or "file".
# "file" writes a 0600 token file to the OS temp directory.
# TEAMDYNAMIX_TOKEN_CACHE=memory
# TEAMDYNAMIX_TIMEOUT_MS=15000
# TEAMDYNAMIX_MAX_SOCKETS=8

# Retries for 503 responses. A 429 is budgeted separately because TeamDynamix
# enforces its quota per IP, so another process can cause one.
# TEAMDYNAMIX_MAX_RETRIES=2
# TEAMDYNAMIX_MAX_RATE_LIMIT_WAITS=3
# TEAMDYNAMIX_MAX_RETRY_DELAY_MS=60000

# Outgoing requests allowed per window, kept under TeamDynamix's own limit.
# TEAMDYNAMIX_RATE_LIMIT=30
# TEAMDYNAMIX_RATE_WINDOW_MS=60000

# --- Caching (set any TTL to 0 to disable that tier) ---

# Reference data: applications, types, statuses, priorities, locations, people.
# TEAMDYNAMIX_CACHE_TTL_MS=600000
# Search result windows, so paging does not re-run a query.
# TEAMDYNAMIX_SEARCH_CACHE_TTL_MS=60000
# Single records and child collections (feeds, tasks, relationships, members).
# TEAMDYNAMIX_RECORD_CACHE_TTL_MS=30000
# TEAMDYNAMIX_CACHE_MAX_ENTRIES=500

# --- Logging ---

# "debug", "info" (default), "warn", "error", or "silent". JSON on stderr.
# TDX_LOG_LEVEL=info

# Optional: transport. "stdio" (default) or "http".
# TRANSPORT=stdio
# PORT=3000

# HTTP defaults to localhost. For an external Hermes deployment, keep this loopback-only.
# HTTP defaults to localhost. For a remote deployment, bind to all interfaces
# and protect every request with a strong bearer token.
# HOST=127.0.0.1
# MCP_AUTH_TOKEN=

# Comma-separated public hostnames accepted by the HTTP server. Recommended
# whenever HOST is not a loopback address (do not include URL schemes).
# MCP_ALLOWED_HOSTS=mcp.example.com

# Comma-separated browser origins allowed to call the MCP endpoint. OpenAI,
# Claude, and VS Code server-to-server clients do not normally send Origin.
# MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai
