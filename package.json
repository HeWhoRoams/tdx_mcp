{
  "name": "teamdynamix-mcp-server",
  "version": "4.0.0",
  "description": "MCP server for the TeamDynamix Web API (tickets, assets/CIs, projects, issues, people/groups, reference data)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "teamdynamix-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/",
    "config/tool-policy.json",
    "config/tool-policy.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "login": "node dist/index.js login",
    "logout": "node dist/index.js logout",
    "whoami": "node dist/index.js whoami",
    "start:http": "cross-env TRANSPORT=http node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && shx chmod +x dist/index.js",
    "clean": "shx rm -rf dist",
    "check:scripts": "tsc --project scripts/tsconfig.json",
    "check:sensitive": "node scripts/check-sensitive.mjs --tree --require-terms",
    "check:package": "node scripts/check-package.mjs",
    "sensitive:add-term": "node scripts/add-sensitive-term.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:url": "tsx scripts/url-resolution-test.ts",
    "test:mcp": "npm run build && tsx scripts/mcp-protocol-test.ts",
    "test:contract": "tsx scripts/contract-test.ts",
    "test:hermes-sso": "tsx scripts/hermes-sso-compat.ts",
    "test:all": "npm run test && npm run check:scripts && npm run test:mcp",
    "prepublishOnly": "npm run test:all && npm run check:sensitive && npm run check:package",
    "pack:mcpb": "node scripts/pack-mcpb.mjs",
    "init": "node dist/index.js init",
    "policy:sync": "tsx scripts/sync-tool-policy.ts",
    "tools:explain": "tsx scripts/explain-tools.ts",
    "bench": "tsx scripts/bench.ts",
    "measure:window": "tsx scripts/measure-window.ts",
    "verify": "tsx scripts/verify-connection.ts",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "smoke-test:write": "tsx scripts/write-smoke-test.ts",
    "list-apps": "tsx scripts/list-apps.ts",
    "search-tickets": "tsx scripts/search-tickets.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.7.9",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.0",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "shx": "^0.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  }
}
